#!/usr/bin/env python3
"""
Tool to create new small tools with a scaffold for Python.

This is a little bit better than plain shell scripts that get out of hand really quickly.
"""

import argparse
import logging
import sys


def setup_logging(debug: bool) -> None:
    """Setup logging for tool.

    Args:
        debug (bool): Increase verbosity for debugging.
    """
    # Info by default unless debug logging is requested.
    log_level = logging.DEBUG if debug else logging.INFO

    logging.basicConfig(
        level=log_level,
        format="%(asctime)s [%(levelname)s] %(message)s",
        handlers=[logging.StreamHandler()],
    )


def main():
    argparser = argparse.ArgumentParser(description="Create a new CLI tool.")
    argparser.add_argument(
        "-v", "--verbose", action="store_true", help="Increase verbosity of output."
    )
    args = argparser.parse_args()

    setup_logging(args.verbose)
    logger = logging.getLogger(__name__)

    return 0


if __name__ == "__main__":
    sys.exit(main())
