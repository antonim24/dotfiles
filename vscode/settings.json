{
    // ----- Appearance ----- //
    "workbench.colorTheme": "Dark Modern",
    "editor.fontSize": 18,
    "window.zoomLevel": 1,
    "editor.minimap.enabled": false,
    "zenMode.hideLineNumbers": false,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.settings.editor": "json",
    // Scrolloff setting
    "editor.cursorSurroundingLines": 8,
    // ----- Generic for all files ----- //
    "files.autoSave": "afterDelay",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.rulers": [120],
    "editor.suggest.insertMode": "replace",
    "editor.autoClosingBrackets": "never",
    // This will force Vscode to always use unix style \n for LF instead of CRLF
    "files.eol": "\n",
    "explorer.excludeGitIgnore": true,
    // Settings for C++ files
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "[cpp]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // CMake Extension
    "cmake.configureOnEdit": false,
    // Doxygen settings
    "doxdocgen.c.triggerSequence": "/**",
    "doxdocgen.cpp.ctorText": "Construct a new {name} object.",
    "doxdocgen.cpp.dtorText": "Destroy the {name} object.",
    "doxdocgen.generic.order": [
        "brief",
        // "empty",
        "tparam",
        "param",
        "return",
        "custom"
    ],
    "doxdocgen.file.fileOrder": [
        "file",
        "brief",
        "date",
        "empty",
        "copyright",
    ],
    "[markdown]": {
        "editor.rulers": [80, 120]
    },
    // ----- Vim Extension Settings ----- //
    "vim.foldfix": true,
    "vim.useSystemClipboard": true,
    "vim.highlightedyank.enable": true,
    "vim.smartRelativeLine": true,
    "vim.leader": "<space>",
    "vim.insertModeKeyBindingsNonRecursive": [
        { // Use jj for escape
            "before": ["j","k"],
            "after": ["<esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["g","d"],
            "commands": ["editor.action.gotoDef"]
        },
        {
            "before": ["g","h"],
            "commands": ["editor.action.showDefinitionPreviewHover"]
        },
        {
            "before": ["<leader>","e"],
            "commands": ["workbench.view.explorer"]
        },
        {
            "before": ["<leader>","f","d"],
            "commands": ["editor.action.formatDocument"]
        },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>","f","s"],
            "commands": ["editor.action.formatSelection"]
        },
        {
            "before": ["p"],
            "commands": ["editor.action.clipboardPasteAction"]
        }
    ],
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-p>": false,
        "<C-w>": false,
    },
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    // Settings for Python files
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "python.analysis.typeEvaluation.deprecateTypingAliases": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "isort.args": ["--profile", "black"],

    "[json][jsonc]": {
        "editor.quickSuggestions": {
            "strings": true
        },
        "editor.suggest.insertMode": "replace",
    },
    // Other Settings
    "files.associations": {
        ".clang-format": "yaml",
        ".clang-tidy": "yaml",
        "vimrc": "Vimscript",
        "*aliases": "shellscript",
        "bash*": "shellscript",
        "profile": "shellscript",
        "*.tcc": "cpp"
    },
    "extensions.ignoreRecommendations": true,
    "workbench.settings.enableNaturalLanguageSearch": false,
    // ----- CSpell ----- //
    "cSpell."
    "cSpell.allowCompoundWords": true,
    "cSpell.customDictionaries": {
        "custom-dictionary-user": {
            "name": "programming-languages",
            "path": "~/.cspell/dictionary_programming_languages.txt",
            "addWords": true,
            "scope": "user"
        }
    },
    "cSpell.flagWords": [
        "wether: whether"
    ],
    // ----- GitLens ----- //
    "git.openRepositoryInParentFolders": "always",
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.recentChange.enabled": false,
    // ----- Java -----
    "java.autobuild.enabled": false,
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "full",
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.defaultColorDecorators": "never",
        "editor.quickSuggestions": {
            "strings": true,
            "other": true,
            "comments": false
        }
    },

    // Other and Experimental
    "editor.inlayHints.enabled": "offUnlessPressed",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "python.analysis.typeCheckingMode": "standard",
    "workbench.editor.empty.hint": "hidden",
    "security.workspace.trust.untrustedFiles": "open",
    "redhat.telemetry.enabled": false,
    "editor.accessibilitySupport": "off",
    "jdk.telemetry.enabled": false,
    "kotlin.languageServer.enabled": true,
    "kotlin.debugAdapter.enabled": true,
    "git.confirmSync": false,
    "workbench.sideBar.location": "right",
    "dotnet.formatting.organizeImportsOnFormat": true,
    "[csharp]": {
        "editor.maxTokenizationLineLength": 2500,
        "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "ansible.lightspeed.enabled": false,
    "ansible.lightspeed.suggestions.enabled": false
}
