# --- History ---

# Where to store state (logs, recent files, etc, etc)
# Zsh State Storage Dir
ZSH_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/zsh"
if [[ ! -d ${ZSH_STATE_DIR} ]]; then
    mkdir -p "${ZSH_STATE_DIR}"
fi

# History
HISTFILE="${ZSH_STATE_DIR}/history.log"
HISTSIZE=5000 # Number saved in memory
SAVEHIST=5000 # Number saved in history file

# History options
setopt EXTENDED_HISTORY # Add timestamps
setopt SHARE_HISTORY # Append immediately to history file
setopt HIST_IGNORE_ALL_DUPS # Ignore duplicates
setopt HIST_IGNORE_SPACE # Ignore command if it started with a space
setopt HIST_REDUCE_BLANKS # Remove extra blank lines

# --- Prompt ---

# Git information
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' %F{yellow}(%b)%f '

# Set up the prompt
precmd() { vcs_info; }
function _prompt_exit_code(){
    local exit_code=$?
    if [[ ${exit_code} != 0 ]]; then
        echo "(${exit_code})"
    fi
}
setopt PROMPT_SUBST
PROMPT='%F{red}$(_prompt_exit_code)%f' # Show return code in red if it failed
PROMPT+='[%T] ' # Time in 24H format
PROMPT+='%F{green}%m%f: ' # Short hostname
PROMPT+='%2~' # Limit path to 2 items. Current dir and parent dir
PROMPT+='${vcs_info_msg_0_}'
PROMPT+=$'\n'"$ "

# --- Aliases ---

# If there is an aliases file, source it
if [[ -f "$DOTFILES/shell/aliases" ]]; then
    source "$DOTFILES/shell/aliases"
fi

# --- Completion ---

# Add Docker completion
FPATH="$XDG_DATA_HOME/docker/completions:$FPATH"

autoload -Uz compinit && compinit
autoload -Uz bashcompinit && bashcompinit
# Load bash completion if it was installed on the system
if [[ -r /etc/profile.d/bash_completion.sh ]]; then
    source /etc/profile.d/bash_completion.sh
fi

